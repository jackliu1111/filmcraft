<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The frozen Python service and FFmpeg/ffprobe load bundled native libraries.
       Ad-hoc signatures have no shared Team ID; library validation otherwise
       rejects these libraries before the runtime processes can start.
       Apply only to these three process entry executables, never the editor,
       outer app, or individual library signatures. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
